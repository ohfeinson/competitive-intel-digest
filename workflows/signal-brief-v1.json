    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const content = $input.item.json.content;\nconst briefText = content[0].text;\nconst today = new Date().toISOString().split('T')[0];\n\n// Split into chunks of 1800 chars at paragraph boundaries\nconst chunks = [];\nconst paragraphs = briefText.split('\\n');\nlet current = '';\n\nfor (const para of paragraphs) {\n  if ((current + '\\n' + para).length > 1800) {\n    if (current) chunks.push(current.trim());\n    current = para;\n  } else {\n    current = current ? current + '\\n' + para : para;\n  }\n}\nif (current) chunks.push(current.trim());\n\nreturn {\n  chunk1: chunks[0] || '',\n  chunk2: chunks[1] || '',\n  chunk3: chunks[2] || '',\n  chunk4: chunks[3] || '',\n  title: 'Signal Brief — ' + today\n};"
      },
