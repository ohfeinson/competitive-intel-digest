    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const xml = $input.item.json.data || '';\n\nconst feedTitleMatch = xml.match(/<title>(.*?)<\\/title>/);\nconst feedTitle = feedTitleMatch ? feedTitleMatch[1] : '';\n\nlet brand = 'Unknown';\nif (feedTitle.includes('Cava')) brand = 'Cava';\nelse if (feedTitle.includes('Sweetgreen')) brand = 'Sweetgreen';\nelse if (feedTitle.includes('Chipotle')) brand = 'Chipotle';\nelse if (feedTitle.includes('Shake Shack')) brand = 'Shake Shack';\n\nconst titleMatches = [...xml.matchAll(/<title><!\\[CDATA\\[(.*?)\\]\\]><\\/title>|<title>(.*?)<\\/title>/g)];\nconst headlines = titleMatches\n  .slice(1)\n  .map(m => (m[1] || m[2] || '').trim())\n  .filter(t => t.length > 0)\n  .slice(0, 8);\n\nlet section = '\\n## ' + brand + '\\n';\nheadlines.forEach(function(h, idx) {\n  section += (idx + 1) + '. ' + h + '\\n';\n});\n\nreturn { brand: brand, section: section };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "a299e92c-60c6-433a-ab96-57451bab83d2",
      "name": "Parse + Merge RSS"
    },
    {
      "parameters": {
        "jsCode": "let fullFeed = '';\n\nfor (const item of items) {\n  fullFeed += item.json.section || '';\n}\n\nconst prompt = `You are a competitive intelligence analyst at Cava, a fast-casual Mediterranean restaurant chain. \n\nBased on the following news headlines from the past week, write a structured competitive intelligence brief.\n\nNEWS HEADLINES:\n${fullFeed}\n\nWrite the brief in this exact format:\n\n# Signal Brief — Week of [insert current date]\n\n## Executive Summary\n2-3 sentences on the most important competitive developments this week.\n\n## Cava\nKey signals and what they mean for Cava's strategy.\n\n## Sweetgreen\nKey signals and what they mean for Cava's strategy.\n\n## Chipotle\nKey signals and what they mean for Cava's strategy.\n\n## Shake Shack\nKey signals and what they mean for Cava's strategy.\n\n## Strategic Implications for Cava\n3-5 bullet points on what Cava should watch, consider, or act on based on this week's signals.`;\n\nreturn [{ json: { prompt: prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        0
      ],
      "id": "09a2bf39-7261-4e1b-a381-b8815d6a8cd3",
      "name": "Build Prompt"
    },
    {
